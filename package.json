{
  "name": "personal-map",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Markdown-first personal map for Obsidian, powered by AMap JS API 2.0.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vryTfmcat/personal-map.git"
  },
  "homepage": "https://github.com/vryTfmcat/personal-map",
